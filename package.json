{
    "name": "NewsJS",
    "version": "1.0.0",
    "description": "News app on TypeScript + Webpack",
    "main": "dist/index.js",
    "scripts": {
        "start": "cross-env TS_NODE_PROJECT=tsconfig.node.json webpack serve --mode development",
        "build": "cross-env TS_NODE_PROJECT=tsconfig.node.json webpack --mode production",
        "type-check": "tsc --noEmit -p tsconfig.json",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist",
        "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings=0",
        "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "ci:format": "prettier --check .",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/rockabil/news-JS.git",
        "homepage": "https://rockabil.github.io/news-JS/"
    },
    "keywords": [],
    "author": "Valery Strokach",
    "license": "ISC",
    "homepage": "",
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "clean-webpack-plugin": "^4.0.0",
        "cross-env": "^10.1.0",
        "css-loader": "^6.10.0",
        "dotenv-webpack": "^9.0.0",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-prettier": "^5.1.3",
        "gh-pages": "^6.3.0",
        "html-webpack-plugin": "^5.6.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "3.2.5",
        "style-loader": "^3.3.4",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "webpack": "^5.90.1",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.0.0",
        "webpack-merge": "^5.10.0"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "prettier --write",
            "eslint --fix --max-warnings=0"
        ],
        "*.{json,md,html,css,scss,yml,yaml}": [
            "prettier --write"
        ]
    }
}
